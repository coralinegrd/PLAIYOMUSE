# Plaiyo — environment variables (placeholders only, never real secrets here)
# Copy this file to .env.local and fill in the values from YOUR OWN
# Supabase project dashboard: Project Settings → API.
# Do not commit .env.local. Do not share these values in chat or tickets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public URL of this app. Used to build the email-confirmation redirect
# (/auth/callback). Locally: http://localhost:3000 — in production, your
# real domain, e.g. https://YOUR-DOMAIN.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only, optional for now (admin scripts). Never expose to the browser
# and never prefix with NEXT_PUBLIC_. Not required by the current app code.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
